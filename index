function showOnly(id){
  document.querySelectorAll('#app > .screen').forEach(s=>s.classList.remove('active'));
  document.getElementById(id).classList.add('active');
}

async function boot(){
  document.getElementById('setupLogo').src = ASSETS.logo;
  document.getElementById('loginLogo').src = ASSETS.logo;
  document.getElementById('logoImg').src = ASSETS.logo;

  // Konfigurasi Firebase sudah disisipkan langsung di aplikasi (lihat FIREBASE_CONFIG di atas).
  // Layar "screen-setup" tetap ada sebagai cadangan otomatis jika koneksi ke project ini gagal.
  await initFirebase(FIREBASE_CONFIG);
}

async function submitFirebaseConfig(){
  const raw = document.getElementById('fbConfigInput').value.trim();
  const errEl = document.getElementById('setupError');
  errEl.classList.remove('show');
  let cfg;
  try{ cfg = JSON.parse(raw); }
  catch(e){ errEl.textContent = 'Format JSON tidak valid. Salin persis dari Firebase Console.'; errEl.classList.add('show'); return; }
  if(!cfg.apiKey || !cfg.projectId){
    errEl.textContent = 'Konfigurasi belum lengkap (minimal perlu apiKey & projectId).';
    errEl.classList.add('show');
    return;
  }
  try{ await window.storage.set('mmt_firebase_config', JSON.stringify(cfg), true); }
  catch(e){ errEl.textContent = 'Gagal menyimpan konfigurasi.'; errEl.classList.add('show'); return; }
  await initFirebase(cfg);
}

async function initFirebase(cfg){
  showOnly('screen-loading');
  try{
    if(!firebase.apps.length) firebase.initializeApp(cfg);
    db = firebase.firestore();
    await seedIfEmpty();
    showOnly('screen-login');
  }catch(e){
    console.error(e);
    showOnly('screen-setup');
    const errEl = document.getElementById('setupError');
    errEl.textContent = 'Gagal terhubung ke Firebase: ' + e.message;
    errEl.classList.add('show');
  }
}

async function seedIfEmpty(){
  // seed default admin
  const usersSnap = await db.collection('users').limit(1).get();
  if(usersSnap.empty){
    await db.collection('users').doc('admin').set({
      username:'admin', password:'admin123', role:'admin', name:'Administrator', createdAt: Date.now()
    });
  }
  // seed default questions
  const qSnap = await db.collection('questions').limit(1).get();
  if(qSnap.empty){
    const batch = db.batch();
    DEFAULT_QUESTIONS.forEach(q=>{
      const ref = db.collection('questions').doc();
      batch.set(ref, {category:q.category, question:q.question, options:q.options, correct:q.correct, createdAt:Date.now()});
    });
    await batch.commit();
  }
}

function togglePw(id, btn){
  const el = document.getElementById(id);
  if(el.type==='password'){ el.type='text'; btn.textContent='Sembunyikan'; }
  else{ el.type='password'; btn.textContent='Lihat'; }
}

