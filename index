// ---------------- CATEGORY PICK ----------------
function startCategoryPick(){
  goto('category');
  const cats = [ {key:'all',name:'Semua Soal'}, {key:'helper',name:'Helper AC'}, {key:'teknisi',name:'Teknisi AC'}, {key:'umum',name:'Umum'} ];
  const wrap = document.getElementById('catList');
  wrap.innerHTML='';
  cats.forEach(c=>{
    const n = c.key==='all' ? state.questions.length : state.questions.filter(q=>q.category===c.key).length;
    if(c.key!=='all' && n===0) return;
    const el = document.createElement('div');
    el.className = 'cat-item' + (state.quiz.category===c.key ? ' selected':'');
    el.innerHTML = `<div><div class="name">${c.name}</div><div class="count">${n} soal</div></div><div class="cat-radio"></div>`;
    el.onclick = ()=>{ state.quiz.category = c.key; startCategoryPick(); };
    wrap.appendChild(el);
  });
  if(!wrap.querySelector('.cat-item.selected') && wrap.firstChild){ state.quiz.category='all'; wrap.firstChild.classList.add('selected'); }
  const anyQ = state.questions.length>0;
  document.getElementById('btnBeginQuiz').disabled = !anyQ;
  if(!anyQ) showToast('Belum ada soal. Minta Admin menambahkan soal.');
}

// ---------------- QUIZ ----------------
function beginQuiz(){
  const cat = state.quiz.category || 'all';
  let pool = cat==='all' ? state.questions : state.questions.filter(q=>q.category===cat);
  if(pool.length===0){ showToast('Tidak ada soal di kategori ini'); return; }
  pool = shuffle(pool);
  state.quiz = { category:cat, pool, idx:0, score:0, correct:0, wrong:0, answered:false };
  goto('quiz');
  renderQuestion();
}
function renderQuestion(){
  const q = state.quiz.pool[state.quiz.idx];
  document.getElementById('quizCatTag').textContent = catLabel(q.category).toUpperCase();
  document.getElementById('quizCount').textContent = (state.quiz.idx+1)+' / '+state.quiz.pool.length;
  document.getElementById('qText').textContent = q.question;
  document.getElementById('feedbackBanner').className = 'feedback-banner';
  document.getElementById('btnNext').style.display = 'none';
  document.getElementById('quizSpeech').textContent = 'Ayo jawab dengan yakin!';
  setMascot(document.getElementById('quizMascotImg'), document.getElementById('quizMascot'), 'face_berpikir');
  state.quiz.answered = false;

  const optList = document.getElementById('optList');
  optList.innerHTML='';
  const opts = [['a',q.options.a],['b',q.options.b],['c',q.options.c],['d',q.options.d]].filter(o=>o[1] && o[1].trim()!=='');
  opts.forEach(([key,text])=>{
    const el = document.createElement('div');
    el.className='opt';
    el.innerHTML = `<div class="key">${key.toUpperCase()}</div><div class="txt">${text}</div>`;
    el.onclick = ()=>answer(key, q, el);
    optList.appendChild(el);
  });
  updateGauge();
}
function updateGauge(){
  const total = state.quiz.pool.length;
  const done = state.quiz.idx;
  const frac = total>0 ? done/total : 0;
  const circumference = 270;
  document.getElementById('gaugeFill').setAttribute('stroke-dashoffset', String(circumference - circumference*frac));
  document.getElementById('gaugeNeedle').style.transform = `rotate(${-90 + frac*180}deg)`;
  document.getElementById('gaugeScoreTxt').textContent = state.quiz.score;
}
function answer(key, q, el){
  if(state.quiz.answered) return;
  state.quiz.answered = true;
  const correct = key === q.correct;
  document.querySelectorAll('#optList .opt').forEach(o=>o.classList.add('disabled'));
  el.classList.add(correct ? 'correct':'wrong');
  if(!correct){
    const keys = ['a','b','c','d'].filter(k=>q.options[k]&&q.options[k].trim()!=='');
    const correctEl = [...document.querySelectorAll('#optList .opt')][keys.indexOf(q.correct)];
    if(correctEl) correctEl.classList.add('correct');
  }
  const banner = document.getElementById('feedbackBanner');
  const mascotImg = document.getElementById('quizMascotImg');
  const mascotWrap = document.getElementById('quizMascot');
  if(correct){
    state.quiz.score += 1; state.quiz.correct += 1;
    banner.className='feedback-banner ok show';
    banner.innerHTML = '✅ &nbsp;Benar! +1 poin';
    setMascot(mascotImg, mascotWrap, Math.random()>0.5?'face_tertawa':'face_senyum');
    document.getElementById('quizSpeech').textContent = ['Mantap!','Siap!','OK!','Betul!'][Math.floor(Math.random()*4)];
  }else{
    state.quiz.wrong += 1;
    banner.className='feedback-banner bad show';
    banner.innerHTML = '❌ &nbsp;Kurang tepat. Jawaban benar: <b>'+q.correct.toUpperCase()+'</b>';
    setMascot(mascotImg, mascotWrap, Math.random()>0.5?'face_kecewa':'face_marah');
    document.getElementById('quizSpeech').textContent = 'Semangat, coba lagi ya!';
  }
  document.getElementById('gaugeScoreTxt').textContent = state.quiz.score;
  document.getElementById('btnNext').style.display='flex';
  document.getElementById('btnNext').textContent = (state.quiz.idx===state.quiz.pool.length-1) ? 'Lihat Hasil →' : 'Lanjut →';
}
async function nextQuestion(){
  state.quiz.idx += 1;
  if(state.quiz.idx >= state.quiz.pool.length){ await finishQuiz(); return; }
  renderQuestion();
}
async function finishQuiz(){
  updateGauge();
  const total = state.quiz.pool.length;
  const pct = total>0 ? Math.round(state.quiz.correct/total*100) : 0;
  try{
    await addAttempt({
      username: currentUser.username, name: currentUser.name,
      date: new Date().toISOString(), category: state.quiz.category,
      points: state.quiz.score, correct: state.quiz.correct, total: total
    });
  }catch(e){ console.error(e); showToast('Gagal menyimpan hasil ke server'); }
  document.getElementById('resultScore').textContent = state.quiz.score;
  document.getElementById('resultPct').textContent = `${state.quiz.correct} dari ${total} soal benar (${pct}%)`;
  document.getElementById('resBenar').textContent = state.quiz.correct;
  document.getElementById('resSalah').textContent = state.quiz.wrong;
  let faceKey, msg;
  if(pct>=80){ faceKey='face_tertawa'; msg='Luar Biasa! 🎉'; }
  else if(pct>=60){ faceKey='face_senyum'; msg='Kerja Bagus!'; }
  else if(pct>=40){ faceKey='face_kagum'; msg='Terus Berlatih!'; }
  else { faceKey='face_kecewa'; msg='Jangan Menyerah!'; }
  document.getElementById('resultFaceImg').src = ASSETS[faceKey];
  document.getElementById('resultMsg').textContent = msg;
  goto('result');
}

// ---------------- STATS (karyawan) ----------------
let _myAttemptsCache = [];
async function renderStats(){
  _myAttemptsCache = await loadMyAttempts();
  const total = _myAttemptsCache.reduce((s,x)=>s+x.points,0);
  const totalQ = _myAttemptsCache.reduce((s,x)=>s+x.total,0);
  const totalC = _myAttemptsCache.reduce((s,x)=>s+x.correct,0);
  document.getElementById('statTotal').textContent = total;
  document.getElementById('statSessions').textContent = _myAttemptsCache.length;
  document.getElementById('statAvg').textContent = totalQ>0 ? Math.round(totalC/totalQ*100)+'%' : '0%';

  const years = new Set(_myAttemptsCache.map(s=>new Date(s.date).getFullYear()));
  const curYear = new Date().getFullYear();
  years.add(curYear);
  const yearArr = [...years].sort((a,b)=>b-a);
  const sel = document.getElementById('yearSelect');
  sel.innerHTML = yearArr.map(y=>`<option value="${y}">${y}</option>`).join('');
  sel.value = curYear;
  renderStatsForYear();
}
function renderStatsForYear(){
  const year = parseInt(document.getElementById('yearSelect').value);
  const monthly = Array(12).fill(0);
  const monthlyMeta = Array(12).fill(null).map(()=>({sessions:0, correct:0, total:0}));
  _myAttemptsCache.forEach(s=>{
    const d = new Date(s.date);
    if(d.getFullYear()===year){
      monthly[d.getMonth()] += s.points;
      monthlyMeta[d.getMonth()].sessions += 1;
      monthlyMeta[d.getMonth()].correct += s.correct;
      monthlyMeta[d.getMonth()].total += s.total;
    }
  });
  const max = Math.max(...monthly, 1);
  document.getElementById('barChart').innerHTML = monthly.map((v,i)=>{
    const h = Math.max(3, Math.round(v/max*88));
    return `<div class="bar-col"><div class="bar-fill ${v===0?'zero':''}" style="height:${h}px"></div><div class="bar-lbl">${MONTH_SHORT[i]}</div></div>`;
  }).join('');
  const rows = monthly.map((v,i)=>({i,v,meta:monthlyMeta[i]})).filter(r=>r.v>0 || r.meta.sessions>0).reverse();
  const listEl = document.getElementById('monthList');
  listEl.innerHTML = rows.length===0 ? '<div class="empty-note">Belum ada riwayat kuis di tahun ini.</div>' :
    rows.map(r=>`<div class="month-row"><div><div class="mname">${MONTH_NAMES[r.i]}</div><div class="mdetail">${r.meta.sessions} sesi · ${r.meta.correct}/${r.meta.total} benar</div></div><div class="mpts">${r.v} pts</div></div>`).join('');
}

