async function doLogin(){
  const uname = document.getElementById('loginUsername').value.trim().toLowerCase();
  const pass = document.getElementById('loginPassword').value;
  const errEl = document.getElementById('loginError');
  errEl.classList.remove('show');
  if(!uname || !pass){ errEl.textContent='Username dan password wajib diisi.'; errEl.classList.add('show'); return; }
  const btn = document.getElementById('btnLogin');
  btn.classList.add('btn-loading'); btn.disabled = true;
  try{
    const doc = await db.collection('users').doc(uname).get();
    if(!doc.exists || doc.data().password !== pass){
      errEl.textContent = 'Username atau password salah.'; errEl.classList.add('show');
      return;
    }
    const d = doc.data();
    currentUser = { username: uname, name: d.name || uname, role: d.role || 'karyawan' };
    document.getElementById('loginUsername').value='';
    document.getElementById('loginPassword').value='';
    await enterApp();
  }catch(e){
    console.error(e);
    errEl.textContent = 'Gagal masuk: ' + e.message; errEl.classList.add('show');
  }finally{
    btn.classList.remove('btn-loading'); btn.disabled=false;
  }
}
