// ---------------- ADMIN: LEADERBOARD ----------------
async function renderLeaderboard(){
  const [empSnap, attempts] = await Promise.all([
    db.collection('users').where('role','==','karyawan').get(),
    loadAllAttempts()
  ]);
  const emps = empSnap.docs.map(d=>d.data());
  const totals = {};
  emps.forEach(u=>{ totals[u.username] = {name:u.name||u.username, points:0, sessions:0}; });
  attempts.forEach(a=>{
    if(!totals[a.username]) totals[a.username] = {name:a.name||a.username, points:0, sessions:0};
    totals[a.username].points += a.points;
    totals[a.username].sessions += 1;
  });
  const ranked = Object.values(totals).sort((a,b)=>b.points-a.points);
  const wrap = document.getElementById('rankList');
  if(ranked.length===0){ wrap.innerHTML = '<div class="empty-state"><div class="ic">🏆</div>Belum ada data karyawan.</div>'; return; }
  wrap.innerHTML = ranked.map((r,i)=>{
    const cls = i===0?'gold':i===1?'silver':i===2?'bronze':'';
    return `<div class="rank-row"><div class="rank-num ${cls}">${i+1}</div><div class="rank-name">${r.name}<div style="font-size:10.5px;color:var(--muted);font-weight:500;">${r.sessions} sesi kuis</div></div><div class="rank-pts">${r.points} pts</div></div>`;
  }).join('');
}

// ---------------- INIT ----------------
boot();
</script>
</body>
</html>
