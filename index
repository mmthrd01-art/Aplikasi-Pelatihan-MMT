<!DOCTYPE html>
<html lang="id">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0">
<title>Mitra Multi Teknik Quiz</title>
<script src="https://www.gstatic.com/firebasejs/10.12.2/firebase-app-compat.js"></script>
<script src="https://www.gstatic.com/firebasejs/10.12.2/firebase-firestore-compat.js"></script>
<style>
  @import url('https://fonts.googleapis.com/css2?family=Rajdhani:wght@500;600;700&family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@500;700&display=swap');

  :root{
    --navy-deep:#04102A; --navy:#071B45; --blue:#01319A; --blue-light:#1E56C7;
    --frost:#EEF4FC; --frost-2:#DCE9FA; --cyan:#3FD6E8; --amber:#FFB020;
    --green:#22C55E; --red:#EF4444; --ink:#0A1730; --muted:#5A6B8C; --radius:20px;
  }
  *{box-sizing:border-box;}
  html,body{margin:0;padding:0;}
  body{
    font-family:'Inter',sans-serif;
    background:radial-gradient(circle at 15% -10%, #123a8c 0%, transparent 45%),
      radial-gradient(circle at 100% 0%, #062057 0%, transparent 40%),
      linear-gradient(180deg,var(--navy-deep) 0%, var(--navy) 100%);
    min-height:100vh; color:var(--ink); display:flex; justify-content:center; -webkit-font-smoothing:antialiased;
  }
  #app{width:100%;max-width:460px;min-height:100vh;background:var(--frost);position:relative;
    display:flex;flex-direction:column;box-shadow:0 0 60px rgba(0,0,0,.5);overflow:hidden;}

  .topbar{background:linear-gradient(135deg,var(--navy) 0%, var(--blue) 100%);padding:16px 18px 20px;color:#fff;position:relative;overflow:hidden;}
  .topbar::after{content:"";position:absolute;right:-40px;top:-40px;width:160px;height:160px;border-radius:50%;
    background:radial-gradient(circle, rgba(63,214,232,.25) 0%, transparent 70%);}
  .topbar-row{display:flex;align-items:center;gap:10px;position:relative;z-index:1;}
  .logo-badge{width:42px;height:42px;border-radius:12px;background:#fff;display:flex;align-items:center;justify-content:center;
    padding:4px;flex-shrink:0;box-shadow:0 4px 14px rgba(0,0,0,.25);}
  .logo-badge img{width:100%;height:100%;object-fit:contain;}
  .brand-name{font-family:'Rajdhani',sans-serif;font-weight:700;font-size:19px;letter-spacing:.3px;line-height:1.1;}
  .brand-sub{font-size:10.5px;letter-spacing:1.5px;opacity:.75;text-transform:uppercase;font-weight:600;}
  .topbar-user{margin-left:auto;display:flex;align-items:center;gap:8px;position:relative;z-index:1;}
  .role-badge{font-size:9.5px;font-weight:700;letter-spacing:.5px;text-transform:uppercase;background:rgba(255,255,255,.18);
    padding:4px 9px;border-radius:20px;}
  .logout-btn{background:rgba(255,255,255,.14);border:none;color:#fff;width:32px;height:32px;border-radius:10px;
    font-size:14px;cursor:pointer;}

  .screen{padding:18px 18px 100px;flex:1;display:none;animation:fadeIn .25s ease;}
  .screen.active{display:block;}
  .screen.noNav{padding-bottom:24px;}
  @keyframes fadeIn{from{opacity:0;transform:translateY(6px)}to{opacity:1;transform:translateY(0)}}

  h1.page-title{font-family:'Rajdhani',sans-serif;font-size:22px;font-weight:700;color:var(--navy);margin:2px 0 4px;}
  p.page-sub{color:var(--muted);font-size:13.5px;margin:0 0 16px;line-height:1.5;}

  .mascot-wrap{display:flex;align-items:center;gap:12px;}
  .mascot-face{width:64px;height:64px;border-radius:50%;overflow:hidden;flex-shrink:0;border:3px solid #fff;
    box-shadow:0 4px 14px rgba(1,49,154,.35);background:var(--frost-2);transition:transform .25s cubic-bezier(.34,1.56,.64,1);}
  .mascot-face img{width:100%;height:100%;object-fit:cover;display:block;}
  .mascot-face.pop{animation:pop .45s cubic-bezier(.34,1.56,.64,1);}
  @keyframes pop{0%{transform:scale(.7) rotate(-8deg);}60%{transform:scale(1.12) rotate(4deg);}100%{transform:scale(1) rotate(0);}}
  .speech{background:#fff;border-radius:14px 14px 14px 4px;padding:9px 14px;font-family:'Rajdhani',sans-serif;
    font-weight:700;font-size:14.5px;color:var(--blue);box-shadow:0 3px 10px rgba(1,49,154,.12);}

  /* ---- Login / Setup ---- */
  .auth-wrap{min-height:100vh;display:flex;flex-direction:column;justify-content:center;padding:30px 26px;}
  .auth-logo{width:78px;height:78px;margin:0 auto 14px;background:#fff;border-radius:20px;display:flex;align-items:center;
    justify-content:center;padding:8px;box-shadow:0 10px 26px rgba(1,49,154,.28);}
  .auth-logo img{width:100%;height:100%;object-fit:contain;}
  .auth-title{text-align:center;font-family:'Rajdhani',sans-serif;font-weight:700;font-size:22px;color:#fff;margin-bottom:2px;}
  .auth-sub{text-align:center;font-size:12.5px;color:#B9C8E8;margin-bottom:26px;}
  .auth-card{background:#fff;border-radius:22px;padding:24px 20px;box-shadow:0 20px 50px rgba(0,0,0,.35);}
  .field{margin-bottom:14px;}
  .field label{display:block;font-size:12px;font-weight:700;color:var(--navy);margin-bottom:5px;letter-spacing:.2px;}
  .field textarea,.field input[type=text],.field input[type=password],.field input[type=number]{
    width:100%;border:1.5px solid #DCE6F5;border-radius:11px;padding:11px 12px;font-size:14.5px;
    font-family:'Inter',sans-serif;color:var(--ink);resize:vertical;}
  .field textarea:focus,.field input:focus{outline:none;border-color:var(--blue);}
  .field select{width:100%;border:1.5px solid #DCE6F5;border-radius:11px;padding:10px 12px;font-size:14px;background:#fff;}
  .pw-row{position:relative;}
  .pw-toggle{position:absolute;right:10px;top:50%;transform:translateY(-50%);background:none;border:none;color:var(--muted);
    font-size:12px;cursor:pointer;font-weight:600;}
  .auth-error{background:#FDEEEE;color:#C51F1F;font-size:12.5px;font-weight:600;padding:9px 12px;border-radius:10px;margin-bottom:12px;display:none;}
  .auth-error.show{display:block;}
  .auth-hint{text-align:center;font-size:11.5px;color:#8CA0C8;margin-top:16px;line-height:1.6;}
  .auth-hint b{color:#D7E3F9;}
  .link-btn{background:none;border:none;color:var(--cyan);font-size:12px;font-weight:600;cursor:pointer;text-decoration:underline;}

  /* ---- Buttons ---- */
  .btn{border:none;border-radius:13px;padding:13px 18px;font-family:'Rajdhani',sans-serif;font-weight:700;font-size:15px;
    letter-spacing:.3px;cursor:pointer;display:flex;align-items:center;justify-content:center;gap:8px;width:100%;
    transition:transform .12s, filter .12s;}
  .btn:active{transform:scale(.97);}
  .btn-primary{background:linear-gradient(135deg,var(--blue),var(--blue-light));color:#fff;box-shadow:0 6px 16px rgba(1,49,154,.3);}
  .btn-outline{background:#fff;color:var(--blue);border:1.5px solid var(--blue);}
  .btn-ghost{background:var(--frost-2);color:var(--navy);}
  .btn-danger{background:#FDEBEB;color:var(--red);}
  .btn-sm{padding:8px 12px;font-size:13px;border-radius:10px;width:auto;}
  .btn:disabled{opacity:.5;cursor:not-allowed;}
  .btn-loading{position:relative;color:transparent!important;}
  .btn-loading::after{content:"";position:absolute;width:16px;height:16px;border:2.5px solid rgba(255,255,255,.4);
    border-top-color:#fff;border-radius:50%;animation:spin .7s linear infinite;}
  @keyframes spin{to{transform:rotate(360deg);}}

  /* ---- Home ---- */
  .hero-card{background:linear-gradient(135deg,var(--blue) 0%, #0741C4 100%);border-radius:var(--radius);padding:20px;
    color:#fff;position:relative;overflow:hidden;margin-bottom:16px;}
  .hero-card::before{content:"";position:absolute;left:-30px;bottom:-50px;width:180px;height:180px;border-radius:50%;
    background:radial-gradient(circle, rgba(63,214,232,.3), transparent 70%);}
  .hero-top{display:flex;justify-content:space-between;align-items:flex-start;position:relative;z-index:1;}
  .hero-greet{font-family:'Rajdhani',sans-serif;font-size:20px;font-weight:700;}
  .hero-greet span{color:var(--cyan);}
  .hero-date{font-size:11.5px;opacity:.8;margin-top:2px;}
  .hero-points{margin-top:14px;position:relative;z-index:1;display:flex;align-items:baseline;gap:8px;}
  .hero-points .num{font-family:'JetBrains Mono',monospace;font-size:34px;font-weight:700;letter-spacing:-1px;
    text-shadow:0 0 18px rgba(63,214,232,.6);}
  .hero-points .lbl{font-size:11px;letter-spacing:1.5px;text-transform:uppercase;opacity:.8;}

  .menu-grid{display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-bottom:16px;}
  .menu-card{background:#fff;border-radius:16px;padding:16px 14px;border:1px solid #E1E9F7;display:flex;flex-direction:column;
    gap:8px;cursor:pointer;transition:transform .15s, box-shadow .15s;text-align:left;}
  .menu-card:active{transform:scale(.97);}
  .menu-card .ic{width:38px;height:38px;border-radius:11px;display:flex;align-items:center;justify-content:center;font-size:18px;}
  .menu-card .ttl{font-family:'Rajdhani',sans-serif;font-weight:700;font-size:15.5px;color:var(--navy);}
  .menu-card .desc{font-size:11.5px;color:var(--muted);line-height:1.4;}

  .stat-strip{display:flex;gap:10px;margin-bottom:6px;}
  .stat-chip{flex:1;background:#fff;border:1px solid #E1E9F7;border-radius:14px;padding:12px;}
  .stat-chip .v{font-family:'JetBrains Mono',monospace;font-weight:700;font-size:20px;color:var(--blue);}
  .stat-chip .k{font-size:10.5px;color:var(--muted);text-transform:uppercase;letter-spacing:.5px;margin-top:2px;}

  /* ---- Category pick ---- */
  .cat-list{display:flex;flex-direction:column;gap:10px;margin-bottom:18px;}
  .cat-item{background:#fff;border:1.5px solid #E1E9F7;border-radius:14px;padding:14px 16px;display:flex;
    justify-content:space-between;align-items:center;cursor:pointer;}
  .cat-item.selected{border-color:var(--blue);background:#F0F6FF;}
  .cat-item .name{font-family:'Rajdhani',sans-serif;font-weight:700;font-size:15.5px;color:var(--navy);}
  .cat-item .count{font-size:11.5px;color:var(--muted);}
  .cat-radio{width:20px;height:20px;border-radius:50%;border:2px solid #C7D5EC;flex-shrink:0;position:relative;}
  .cat-item.selected .cat-radio{border-color:var(--blue);}
  .cat-item.selected .cat-radio::after{content:"";position:absolute;inset:3px;border-radius:50%;background:var(--blue);}

  /* ---- Quiz ---- */
  .quiz-top{display:flex;align-items:center;justify-content:space-between;margin-bottom:10px;}
  .quiz-cat-tag{font-size:10.5px;font-weight:700;letter-spacing:.8px;text-transform:uppercase;color:var(--blue);
    background:#E4EDFB;padding:4px 10px;border-radius:20px;}
  .quiz-count{font-family:'JetBrains Mono',monospace;font-size:13px;color:var(--muted);}
  .gauge-wrap{display:flex;justify-content:center;margin:6px 0 4px;}
  .gauge{width:190px;height:118px;overflow:visible;}
  .gauge-track{stroke:#DCE9FA;}
  .gauge-fill{stroke:var(--cyan);stroke-linecap:round;transition:stroke-dashoffset .5s ease;}
  .gauge-needle{stroke:var(--blue);stroke-width:4;stroke-linecap:round;transform-origin:100px 108px;transition:transform .5s cubic-bezier(.4,1.4,.5,1);}
  .gauge-center{fill:var(--navy);}
  .gauge-score{font-family:'JetBrains Mono',monospace;font-weight:700;font-size:26px;fill:var(--navy);}
  .gauge-score-lbl{font-family:'Inter',sans-serif;font-size:9px;fill:var(--muted);letter-spacing:1px;}
  .q-card{background:#fff;border-radius:var(--radius);padding:20px;margin:10px 0 16px;box-shadow:0 6px 22px rgba(10,23,48,.06);
    border:1px solid #EDF2FB;}
  .q-text{font-family:'Rajdhani',sans-serif;font-weight:600;font-size:17.5px;color:var(--navy);line-height:1.4;}
  .opt-list{display:flex;flex-direction:column;gap:10px;}
  .opt{display:flex;align-items:center;gap:12px;background:#fff;border:1.5px solid #E1E9F7;border-radius:14px;
    padding:13px 14px;cursor:pointer;transition:all .15s;}
  .opt:active{transform:scale(.985);}
  .opt .key{width:30px;height:30px;border-radius:9px;background:var(--frost-2);color:var(--blue);display:flex;
    align-items:center;justify-content:center;font-family:'JetBrains Mono',monospace;font-weight:700;font-size:13.5px;flex-shrink:0;}
  .opt .txt{font-size:14.5px;color:var(--ink);font-weight:500;}
  .opt.correct{border-color:var(--green);background:#EEFBF2;}
  .opt.correct .key{background:var(--green);color:#fff;}
  .opt.wrong{border-color:var(--red);background:#FDEEEE;}
  .opt.wrong .key{background:var(--red);color:#fff;}
  .opt.disabled{pointer-events:none;}
  .feedback-banner{margin-top:14px;padding:12px 14px;border-radius:13px;font-family:'Rajdhani',sans-serif;font-weight:700;
    font-size:14.5px;display:none;align-items:center;gap:10px;}
  .feedback-banner.show{display:flex;animation:fadeIn .2s ease;}
  .feedback-banner.ok{background:#EAFBF0;color:#118A3E;}
  .feedback-banner.bad{background:#FDEEEE;color:#C51F1F;}

  /* ---- Result ---- */
  .result-hero{text-align:center;padding:10px 0 20px;}
  .result-face{width:110px;height:110px;border-radius:50%;margin:0 auto 14px;border:4px solid #fff;
    box-shadow:0 10px 26px rgba(1,49,154,.28);overflow:hidden;}
  .result-face img{width:100%;height:100%;object-fit:cover;}
  .result-score{font-family:'JetBrains Mono',monospace;font-weight:700;font-size:44px;color:var(--navy);}
  .result-pct{font-size:14px;color:var(--muted);margin-top:2px;}
  .result-msg{font-family:'Rajdhani',sans-serif;font-weight:700;font-size:18px;color:var(--blue);margin-top:8px;}
  .result-grid{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin:18px 0;}
  .result-box{background:#fff;border:1px solid #E1E9F7;border-radius:14px;padding:14px;text-align:center;}
  .result-box .v{font-family:'JetBrains Mono',monospace;font-weight:700;font-size:20px;color:var(--navy);}
  .result-box .k{font-size:10.5px;color:var(--muted);text-transform:uppercase;letter-spacing:.5px;margin-top:3px;}

  /* ---- Stats ---- */
  .readout{background:linear-gradient(135deg,var(--navy-deep),var(--navy));border-radius:var(--radius);padding:20px;
    color:#fff;margin-bottom:16px;position:relative;overflow:hidden;}
  .readout::after{content:"";position:absolute;right:-30px;top:-30px;width:140px;height:140px;border-radius:50%;
    background:radial-gradient(circle, rgba(63,214,232,.22), transparent 70%);}
  .readout-lbl{font-size:10.5px;letter-spacing:2px;text-transform:uppercase;opacity:.65;position:relative;z-index:1;}
  .readout-num{font-family:'JetBrains Mono',monospace;font-weight:700;font-size:46px;color:var(--cyan);
    text-shadow:0 0 22px rgba(63,214,232,.55);position:relative;z-index:1;letter-spacing:-1px;}
  .readout-sub{display:flex;gap:18px;margin-top:12px;position:relative;z-index:1;}
  .readout-sub .n{font-family:'JetBrains Mono',monospace;font-weight:700;font-size:16px;color:#fff;display:block;}
  .readout-sub .l{font-size:10px;opacity:.6;text-transform:uppercase;letter-spacing:.6px;}
  .section-hd{display:flex;justify-content:space-between;align-items:center;margin:20px 0 10px;}
  .section-hd h3{font-family:'Rajdhani',sans-serif;font-size:15.5px;color:var(--navy);margin:0;font-weight:700;}
  select.year-select{font-family:'JetBrains Mono',monospace;font-weight:700;font-size:12.5px;color:var(--blue);
    border:1.5px solid #C7D5EC;border-radius:9px;padding:5px 8px;background:#fff;}
  .bar-chart{display:flex;align-items:flex-end;gap:5px;height:120px;background:#fff;border:1px solid #E1E9F7;
    border-radius:14px;padding:14px 10px 8px;margin-bottom:14px;}
  .bar-col{flex:1;display:flex;flex-direction:column;align-items:center;justify-content:flex-end;height:100%;gap:4px;}
  .bar-fill{width:100%;max-width:20px;background:linear-gradient(180deg,var(--cyan),var(--blue));border-radius:5px 5px 2px 2px;
    min-height:3px;transition:height .4s ease;}
  .bar-fill.zero{background:#E1E9F7;}
  .bar-lbl{font-size:8.5px;color:var(--muted);letter-spacing:.3px;}
  .month-row{display:flex;justify-content:space-between;align-items:center;background:#fff;border:1px solid #EDF2FB;
    border-radius:12px;padding:11px 14px;margin-bottom:8px;}
  .month-row .mname{font-family:'Rajdhani',sans-serif;font-weight:700;font-size:14px;color:var(--navy);}
  .month-row .mdetail{font-size:11px;color:var(--muted);margin-top:1px;}
  .month-row .mpts{font-family:'JetBrains Mono',monospace;font-weight:700;color:var(--blue);font-size:15px;}
  .empty-note{text-align:center;color:var(--muted);font-size:13px;padding:26px 10px;}

  /* ---- Admin: soal & karyawan ---- */
  .admin-item{background:#fff;border:1px solid #E1E9F7;border-radius:14px;padding:13px 14px;margin-bottom:10px;}
  .admin-item .tags{display:flex;gap:6px;margin-bottom:6px;}
  .admin-tag{font-size:9.5px;font-weight:700;text-transform:uppercase;letter-spacing:.5px;padding:3px 8px;border-radius:20px;}
  .admin-tag.helper{background:#FFF3D9;color:#9A6B00;}
  .admin-tag.teknisi{background:#E4EDFB;color:var(--blue);}
  .admin-tag.umum{background:#EAFBF0;color:#118A3E;}
  .admin-q{font-size:13.5px;color:var(--ink);font-weight:500;line-height:1.4;margin-bottom:8px;}
  .admin-actions{display:flex;gap:8px;}

  form.qform{display:flex;flex-direction:column;gap:12px;}
  .opt-edit-row{display:flex;align-items:center;gap:8px;margin-bottom:8px;}
  .opt-edit-row .okey{width:30px;height:30px;border-radius:8px;background:var(--frost-2);color:var(--blue);
    display:flex;align-items:center;justify-content:center;font-weight:700;font-size:12.5px;flex-shrink:0;font-family:'JetBrains Mono',monospace;}
  .opt-edit-row input[type=radio]{width:18px;height:18px;accent-color:var(--blue);flex-shrink:0;}
  .correct-hint{font-size:10.5px;color:var(--muted);margin-top:-4px;}

  .emp-item{background:#fff;border:1px solid #E1E9F7;border-radius:14px;padding:13px 14px;margin-bottom:10px;
    display:flex;align-items:center;justify-content:space-between;gap:10px;}
  .emp-avatar{width:40px;height:40px;border-radius:50%;background:var(--frost-2);color:var(--blue);display:flex;
    align-items:center;justify-content:center;font-family:'Rajdhani',sans-serif;font-weight:700;font-size:15px;flex-shrink:0;}
  .emp-name{font-family:'Rajdhani',sans-serif;font-weight:700;font-size:14.5px;color:var(--navy);}
  .emp-user{font-size:11px;color:var(--muted);font-family:'JetBrains Mono',monospace;}
  .emp-info{flex:1;min-width:0;display:flex;align-items:center;gap:10px;}

  .rank-row{display:flex;align-items:center;gap:12px;background:#fff;border:1px solid #EDF2FB;border-radius:12px;
    padding:11px 14px;margin-bottom:8px;}
  .rank-num{width:26px;height:26px;border-radius:8px;background:var(--frost-2);color:var(--blue);display:flex;
    align-items:center;justify-content:center;font-family:'JetBrains Mono',monospace;font-weight:700;font-size:12px;flex-shrink:0;}
  .rank-num.gold{background:#FFE9B0;color:#946200;}
  .rank-num.silver{background:#E6E9EF;color:#4A5568;}
  .rank-num.bronze{background:#F3D5B8;color:#8A4E1D;}
  .rank-name{font-family:'Rajdhani',sans-serif;font-weight:700;font-size:14px;color:var(--navy);flex:1;}
  .rank-pts{font-family:'JetBrains Mono',monospace;font-weight:700;color:var(--blue);font-size:14.5px;}

  /* ---- Bottom nav ---- */
  .bottom-nav{position:fixed;bottom:0;left:50%;transform:translateX(-50%);width:100%;max-width:460px;background:#fff;
    border-top:1px solid #E7EDF8;display:flex;padding:8px 6px 10px;box-shadow:0 -6px 20px rgba(10,23,48,.06);z-index:20;}
  .nav-btn{flex:1;background:none;border:none;display:flex;flex-direction:column;align-items:center;gap:3px;
    padding:6px 2px;cursor:pointer;color:var(--muted);}
  .nav-btn .nic{font-size:19px;}
  .nav-btn .nlbl{font-size:10px;font-weight:600;}
  .nav-btn.active{color:var(--blue);}

  .toast{position:fixed;bottom:86px;left:50%;transform:translateX(-50%) translateY(20px);background:var(--navy);color:#fff;
    padding:11px 20px;border-radius:30px;font-size:13px;font-weight:600;opacity:0;pointer-events:none;transition:all .25s ease;
    z-index:50;max-width:90%;text-align:center;}
  .toast.show{opacity:1;transform:translateX(-50%) translateY(0);}
  .toast.noNav{bottom:20px;}

  .modal-overlay{position:fixed;inset:0;background:rgba(4,16,42,.55);display:none;align-items:flex-end;justify-content:center;z-index:60;}
  .modal-overlay.show{display:flex;}
  .modal-sheet{background:#fff;width:100%;max-width:460px;border-radius:20px 20px 0 0;padding:20px 18px 26px;
    max-height:85vh;overflow-y:auto;}
  .modal-hd{display:flex;justify-content:space-between;align-items:center;margin-bottom:14px;}
  .modal-hd h3{font-family:'Rajdhani',sans-serif;font-size:17px;color:var(--navy);margin:0;}
