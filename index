}

function catLabel(c){ return c==='helper' ? 'Helper AC' : c==='teknisi' ? 'Teknisi AC' : 'Umum'; }
function shuffle(arr){ const a=[...arr]; for(let i=a.length-1;i>0;i--){ const j=Math.floor(Math.random()*(i+1)); [a[i],a[j]]=[a[j],a[i]];} return a; }
function showToast(msg){
  const t = document.getElementById('toast');
  t.classList.toggle('noNav', currentUser && currentUser.role==='admin' && state.currentScreen==='leaderboard' ? false : false);
  t.textContent = msg; t.classList.add('show');
  clearTimeout(window._toastTimer);
  window._toastTimer = setTimeout(()=>t.classList.remove('show'), 2200);
}
function setMascot(imgEl, wrapEl, key){
  imgEl.src = ASSETS[key];
  wrapEl.classList.remove('pop'); void wrapEl.offsetWidth; wrapEl.classList.add('pop');
